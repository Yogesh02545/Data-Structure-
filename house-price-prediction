def predict_price(self, input_features):
    """Predict price for new input features"""
    if self.best_model is None:
        print("No model trained yet!")
        return None
    
    # Convert input to array and scale
    input_array = np.array([input_features])
    input_scaled = self.scaler.transform(input_array)
    
    # Predict
    prediction_log = self.best_model.predict(input_scaled)
    
    # Convert back from log if needed
    if self.apply_log_transform:
        predicted_price = np.expm1(prediction_log)[0]
    else:
        predicted_price = prediction_log[0]
    
    return predicted_price

